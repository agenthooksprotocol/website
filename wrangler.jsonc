{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/", "/docs", "/docs/*", "/roadmap", "/roadmap/*"]
  }
}
