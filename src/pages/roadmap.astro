---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getRoadmap, ROADMAP_SOURCE_URL, type RoadmapHorizon } from '../lib/roadmap';

const description = 'What the Agent Hooks Protocol project is working on now, next, and later.';
let roadmap: Awaited<ReturnType<typeof getRoadmap>> | undefined;
let loadError = false;

try {
  roadmap = await getRoadmap(env.AHP_BOT_PRIVATE_KEY);
} catch {
  loadError = true;
  Astro.response.status = 503;
}

Astro.response.headers.set(
  'Cache-Control',
  loadError ? 'no-store' : 'public, max-age=0, s-maxage=300, stale-if-error=86400',
);

const horizons: Array<{ name: RoadmapHorizon; description: string }> = [
  { name: 'Now', description: 'Active priorities and work currently underway.' },
  { name: 'Next', description: 'Priorities expected to follow current work.' },
  { name: 'Later', description: 'Ideas and work being considered for a future horizon.' },
];
const refreshed = roadmap === undefined
  ? undefined
  : new Intl.DateTimeFormat('en', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'UTC',
    }).format(new Date(roadmap.refreshedAt));
---

<Layout
  title="Roadmap – Agent Hooks Protocol"
  socialTitle="Roadmap"
  description={description}
  socialCardPathname="/social-card.png"
>
  <div class="roadmap">
    <header class="roadmap-header">
      <p class="eyebrow">Public project roadmap</p>
      <h1>Now, next, and later</h1>
      <p>{description}</p>
    </header>

    {
      loadError ? (
        <section class="roadmap-state" aria-labelledby="roadmap-unavailable">
          <h2 id="roadmap-unavailable">Roadmap temporarily unavailable</h2>
          <p>GitHub could not be reached and no cached roadmap is available yet.</p>
          <a href={ROADMAP_SOURCE_URL}>View the canonical project on GitHub</a>
        </section>
      ) : roadmap && roadmap.items.length === 0 ? (
        <section class="roadmap-state" aria-labelledby="roadmap-empty">
          <h2 id="roadmap-empty">No roadmap items yet</h2>
          <p>The public project is currently empty. Check GitHub for the latest project activity.</p>
          <a href={roadmap.projectUrl}>View the canonical project on GitHub</a>
        </section>
      ) : (
        <div class="roadmap-horizons">
          {horizons.map((horizon) => {
            const items = roadmap?.items.filter((item) => item.horizon === horizon.name) ?? [];
            return (
              <section class="roadmap-section" aria-labelledby={`horizon-${horizon.name.toLowerCase()}`}>
                <header>
                  <h2 id={`horizon-${horizon.name.toLowerCase()}`}>{horizon.name}</h2>
                  <p>{horizon.description}</p>
                </header>
                {items.length === 0 ? (
                  <p class="roadmap-section-empty">No items in this horizon.</p>
                ) : (
                  <ul class="roadmap-list">
                    {items.map((item) => (
                      <li class="roadmap-item">
                        <div class="roadmap-item-heading">
                          <h3><a href={item.url}>{item.title}</a></h3>
                          {item.status && <span class="roadmap-status">{item.status}</span>}
                        </div>
                        <p class="roadmap-item-meta">
                          {item.kind === 'draft' ? 'Draft item' : `${item.repository} #${item.number}`}
                          {!item.horizonAssigned && ' · Horizon not assigned'}
                        </p>
                        {(item.area || item.labels.length > 0) && (
                          <ul class="roadmap-tags" aria-label={`Area and labels for ${item.title}`}>
                            {item.area && <li class="roadmap-area">Area: {item.area}</li>}
                            {item.labels.map((label) => <li>{label}</li>)}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            );
          })}
        </div>
      )
    }

    {
      roadmap && (
        <footer class="roadmap-provenance">
          <p>
            Source: <a href={roadmap.projectUrl}>{roadmap.projectTitle}</a> on GitHub Projects.
            {' '}Last refreshed <time datetime={roadmap.refreshedAt}>{refreshed} UTC</time>.
            {roadmap.stale && ' GitHub was unavailable, so this is the most recent cached copy.'}
          </p>
        </footer>
      )
    }
  </div>
</Layout>
