---
import Layout from '../layouts/Layout.astro';
import { GITHUB_ORG, SPEC_URL, protocolMetadata } from '../config/nav';
---

<Layout>
  <div class="home">
    <section class="home-hero">
      <p class="eyebrow">
        {protocolMetadata.status} · {protocolMetadata.protocolVersion}
      </p>
      <h1>{protocolMetadata.projectName}</h1>
      <p>{protocolMetadata.projectDescription}</p>
      <div class="button-row">
        <a class="button" href="/docs/">Documentation <span aria-hidden="true">→</span></a>
        <a class="button secondary" href={SPEC_URL}>
          Specification <span aria-hidden="true">→</span>
        </a>
        <a class="button secondary" href={GITHUB_ORG}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
