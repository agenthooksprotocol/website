---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { GITHUB_ORG, SPEC_URL, protocolMetadata, protocolRoutes } from '../config/nav';
import { socialCardPath } from '../lib/social-card';

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
}

const {
  title = protocolMetadata.projectName,
  description = protocolMetadata.projectDescription,
  socialTitle = title,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const socialCardURL = new URL(
  await socialCardPath({ title: socialTitle, description, pathname }),
  Astro.site,
);
const isDocs = pathname === '/docs' || pathname.startsWith('/docs/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101413" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialCardURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${socialTitle} social card`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialCardURL} />
    <meta name="twitter:image:alt" content={`${socialTitle} social card`} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('ahp-theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <Logo />
          <span class="brand-name">{protocolMetadata.projectName}</span>
        </a>
        <a class="draft-badge" href={SPEC_URL}>
          {protocolMetadata.status} · {protocolMetadata.protocolVersion}
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
          <a href={SPEC_URL}>Specification</a>
          <a href={GITHUB_ORG} target="_blank" rel="noreferrer">
            GitHub<span class="external-mark" aria-hidden="true">↗</span>
          </a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-about">
          <a class="brand" href="/">
            <Logo />
            <span class="brand-name">{protocolMetadata.projectName}</span>
          </a>
          <p>Documentation synchronized from the canonical project repository.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={protocolRoutes.contributing}>Contributing</a>
          <a href={protocolRoutes.governance}>Governance</a>
          <a href={protocolRoutes.security}>Security</a>
        </nav>
        <p class="footer-status">
          {protocolMetadata.projectName} {protocolMetadata.protocolVersion} · {protocolMetadata.status}
        </p>
      </div>
    </footer>
  </body>
</html>
