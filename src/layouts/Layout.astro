---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { GITHUB_ORG, SPEC_URL } from '../config/nav';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agent Hooks Protocol',
  description = 'A vendor-neutral protocol for runtime control hooks in AI agent harnesses.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const isDocs = pathname === '/docs' || pathname.startsWith('/docs/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101413" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/social-card-v2.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agent Hooks Protocol documentation" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('ahp-theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <Logo />
          <span class="brand-name">Agent Hooks Protocol</span>
        </a>
        <a class="draft-badge" href={SPEC_URL}>v0.1 Working Draft</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
          <a href="/docs/specification/">Specification</a>
          <a href={GITHUB_ORG} target="_blank" rel="noreferrer">
            GitHub<span class="external-mark" aria-hidden="true">↗</span>
          </a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-about">
          <a class="brand" href="/">
            <Logo />
            <span class="brand-name">Agent Hooks Protocol</span>
          </a>
          <p>
            An open, vendor-neutral protocol for runtime control hooks in AI agent harnesses.
            All current protocol artifacts are Working Drafts.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={SPEC_URL}>Canonical specification</a>
          <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/CONTRIBUTING.md">Contributing</a>
          <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/GOVERNANCE.md">Governance</a>
          <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/SECURITY.md">Security</a>
        </nav>
        <p class="footer-status">AHP v0.1 · Working Draft (0.1.0-draft.1) · Apache-2.0</p>
      </div>
    </footer>
  </body>
</html>
