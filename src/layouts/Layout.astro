---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agent Hooks Protocol',
  description = 'A vendor-neutral protocol for runtime control hooks in AI agent harnesses.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f2" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Agent Hooks Protocol home">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M8 7.5v17M24 7.5v17M8 12h7a4 4 0 0 1 4 4v0a4 4 0 0 0 4 4h1" />
          <circle cx="8" cy="7.5" r="2.5" />
          <circle cx="8" cy="24.5" r="2.5" />
          <circle cx="24" cy="7.5" r="2.5" />
          <circle cx="24" cy="24.5" r="2.5" />
        </svg>
        <span>Agent Hooks Protocol</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#protocol">Protocol</a>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/agenthooksprotocol" target="_blank" rel="noreferrer">
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M8 7.5v17M24 7.5v17M8 12h7a4 4 0 0 1 4 4v0a4 4 0 0 0 4 4h1" />
            <circle cx="8" cy="7.5" r="2.5" />
            <circle cx="8" cy="24.5" r="2.5" />
            <circle cx="24" cy="7.5" r="2.5" />
            <circle cx="24" cy="24.5" r="2.5" />
          </svg>
          <span>Agent Hooks Protocol</span>
        </a>
        <p>An open protocol for interoperable agent runtime hooks.</p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/spec/working-draft.md">Specification</a>
        <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/CONTRIBUTING.md">Contribute</a>
        <a href="https://github.com/agenthooksprotocol/agent-hooks-protocol/blob/main/GOVERNANCE.md">Governance</a>
      </div>
      <p class="footer-status">AHP v0.1 · Working Draft</p>
    </footer>
  </body>
</html>
